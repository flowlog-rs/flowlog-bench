+/// Returns `true` if a repeated row cannot change the aggregate, as for
+/// min and max. Must agree with the runtime's `Semiring::IDEMPOTENT`,
+/// which picks the operators a `Present` aggregate builds.
+pub(super) fn aggregation_is_idempotent(op: AggregationOperator) -> bool {
+    match op {
