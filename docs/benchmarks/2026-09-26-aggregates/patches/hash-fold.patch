+/// Folds each group's weights in a hash table on the worker that owns its
+/// key, and emits the rows the threshold of `Present::reduce` would: at
+/// each completed time, in time order, the answer of every group whose
+/// accumulated weight [`is_new_answer`].
+fn hash_fold<'scope, T, K, S, O>(
+    lifted: VecCollection<'scope, T, K, S>,
+    name: &str,
+    mut merge: impl FnMut(K, S::Value) -> O + 'static,
+) -> VecCollection<'scope, T, O, Present>
+where
+    T: Timestamp + TotalOrder,
+    K: ExchangeData + Hash,
+    S: Semiring + ExchangeData,
+    O: Data,
+{
+    let by_key = Exchange::new(|(key, ..): &(K, T, S)| key.hashed());
