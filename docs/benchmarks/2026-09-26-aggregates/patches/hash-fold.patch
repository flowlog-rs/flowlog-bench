+                        let mut session = output.session(&capability);
+                        for (key, weight) in absorb(&mut answers, weights, last) {
+                            session.give((merge(key, weight.finish()), time.clone(), Present));
+                        }
+                    }
+                    if complete {
+                        answers = FxHashMap::default();
+                    }
+                }
+            },
+        )
+        .as_collection()
+}
