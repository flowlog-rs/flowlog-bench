+    /// Every worker derives the same rows, which min and max may read
+    /// repeated: each group still reports one answer. Count reads distinct
+    /// rows, here spread over the workers, and a default appears once.
+    #[test]
+    fn present_groups_report_once_across_workers() {
+        let answers = Arc::new(Mutex::new(Vec::new()));
+        let outputs = Arc::clone(&answers);
+        let workers = timely::execute(timely::Config::process(4), move |worker| {
+            let index = worker.index() as i64;
+            let outputs = Arc::clone(&outputs);
+            let (mut derived, mut distinct, no_input) = worker.dataflow::<(), _, _>(|scope| {
+                let record = |aggregate: &'static str| {
+                    let outputs = Arc::clone(&outputs);
+                    move |((group, answer), ..): &((i64, i64), (), Present)| {
+                        outputs
+                            .lock()
+                            .expect("answers")
+                            .push((aggregate, *group, *answer));
+                    }
+                };
+                let (derived, rows) = scope.new_collection::<(i64, i64), Present>();
+                let (distinct, distinct_rows) = scope.new_collection::<(i64, i64), Present>();
+                let (no_input, no_rows) = scope.new_collection::<(i64, i64), Present>();
+                let whole = |row| ((), row);
+                let value = |(_, value)| ((), value);
+                let count = |(), n: u32| (0, i64::from(n));
+                flowlog_reduce(rows.clone(), "Min", Min, None, |row| row, |g, v| (g, v))
+                    .inspect(record("min"));
+                flowlog_reduce(rows.clone(), "Max", Max, None, |row| row, |g, v| (g, v))
+                    .inspect(record("max"));
+                flowlog_reduce(rows.clone(), "Min", Min, None, value, |(), v| (0, v))
+                    .inspect(record("global min"));
+                flowlog_reduce(rows, "Max", Max, None, value, |(), v| (0, v))
+                    .inspect(record("global max"));
+                flowlog_reduce(distinct_rows, "Count", Count, Some(()), whole, count)
+                    .inspect(record("count"));
+                flowlog_reduce(no_rows, "Count", Count, Some(()), whole, count)
+                    .inspect(record("empty count"));
+                (derived, distinct, no_input)
+            });
+            for row in [(1, 10), (1, 20), (2, 30), (2, 5), (1, 10)] {
+                derived.update(row, Present);
+            }
+            for value in 0..3 {
+                distinct.update((index, value), Present);
+            }
+            derived.close();
+            distinct.close();
+            no_input.close();
+            while worker.step() {}
+        });
+        for worker in workers.expect("workers start").join() {
+            worker.expect("worker finishes");
+        }
+        let mut answers = answers.lock().expect("answers").clone();
+        answers.sort();
+        assert_eq!(
+            answers,
+            vec![
+                ("count", 0, 12),
+                ("empty count", 0, 0),
+                ("global max", 0, 30),
+                ("global min", 0, 5),
+                ("max", 1, 20),
+                ("max", 2, 30),
+                ("min", 1, 10),
+                ("min", 2, 5),
+            ]
+        );
+    }
+
