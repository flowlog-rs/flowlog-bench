+/// One slot for each time the input frontier has not yet passed, holding
+/// the capability to emit at that time.
+struct Pending<T: Timestamp, W> {
+    slots: Vec<(Capability<T>, W)>,
+}
+
+impl<T: Timestamp, W> Default for Pending<T, W> {
+    fn default() -> Self {
+        Self { slots: Vec::new() }
+    }
+}
+
+impl<T: Timestamp + TotalOrder, W: Default> Pending<T, W> {
+    /// The slot of `time`, opened from `capability` if it is new.
+    #[inline]
+    fn at(&mut self, capability: &InputCapability<T>, time: &T) -> &mut W {
+        // Rows mostly arrive at the newest time, so search from the end.
+        let index = match self.slots.iter().rposition(|(held, _)| held.time() == time) {
+            Some(index) => index,
+            None => {
+                self.slots.push((capability.delayed(time, 0), W::default()));
+                self.slots.len() - 1
+            }
+        };
+        &mut self.slots[index].1
+    }
+
+    /// Removes the slots of the times the frontier has passed, in time
+    /// order, so each time's weights fold onto those of every earlier time.
+    fn ready(&mut self, frontier: &MutableAntichain<T>) -> Vec<(Capability<T>, W)> {
+        let mut ready = Vec::new();
+        let mut index = 0;
+        while index < self.slots.len() {
+            if frontier.less_equal(self.slots[index].0.time()) {
+                index += 1;
+            } else {
+                ready.push(self.slots.swap_remove(index));
+            }
+        }
+        ready.sort_by(|a, b| a.0.time().cmp(b.0.time()));
+        ready
+    }
+}
