+        .inner
+        .unary_frontier::<CapacityContainerBuilder<Vec<(O, T, Present)>>, _, _, _>(
+            by_key,
+            name,
+            |_, _| {
+                let mut pending = Pending::<T, FxHashMap<K, S>>::default();
+                let mut answers = FxHashMap::<K, S>::default();
+                move |(input, frontier), output| {
+                    input.for_each(|capability, data| {
+                        for (key, time, weight) in data.drain(..) {
