// LDBC Graphalytics CDLP — UNROLLED K=10 (FlowLog).
// Label propagation, mode label, smallest-id tie-break. Auto-generated.
.decl Arc(src: int64, dst: int64)
.input Arc(IO="file", filename="Arc.csv", delimiter=",")
.decl Vertex(v: int64)
.input Vertex(IO="file", filename="Vertex.csv", delimiter=",")
.decl UndirEdge(u: int64, v: int64)
UndirEdge(u, v) :- Arc(u, v), u != v.
UndirEdge(v, u) :- Arc(u, v), u != v.
.decl Label0(v: int64, l: int64)
Label0(v, v) :- Vertex(v).
.decl NbrLabelCount0(v: int64, l: int64, c: int64)
NbrLabelCount0(v, l, count(u)) :- Label0(u, l), UndirEdge(v, u).
.decl ModeCount0(v: int64, c: int64)
ModeCount0(v, max(c)) :- NbrLabelCount0(v, _, c).
.decl LabelNext0(v: int64, l: int64)
LabelNext0(v, min(l)) :- NbrLabelCount0(v, l, c), ModeCount0(v, c).
.decl HasNbr0(v: int64)
HasNbr0(v) :- NbrLabelCount0(v, _, _).
.decl Label1(v: int64, l: int64)
Label1(v, l) :- LabelNext0(v, l).
Label1(v, lprev) :- Label0(v, lprev), !HasNbr0(v).
