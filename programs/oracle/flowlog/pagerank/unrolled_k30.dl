// LDBC Graphalytics PageRank — UNROLLED K=30 (FlowLog).
// Integer-scaled by 1e9, damping 0.85. Auto-generated; do not hand-edit.
.decl Arc(src: int64, dst: int64)
.input Arc(IO="file", filename="Arc.csv", delimiter=",")
.decl Vertex(v: int64)
.input Vertex(IO="file", filename="Vertex.csv", delimiter=",")
.decl N(n: int64)
N(count(v)) :- Vertex(v).
.decl Outdeg(v: int64, d: int64)
Outdeg(v, count(u)) :- Arc(v, u).
.decl Base(b: int64)
Base(150000000 / n) :- N(n).
.decl PR0(v: int64, pr: int64)
PR0(v, 1000000000 / n) :- Vertex(v), N(n).
.decl ContribTerm0(u: int64, v: int64, t: int64)
ContribTerm0(u, v, pr / d) :- PR0(v, pr), Arc(v, u), Outdeg(v, d).
.decl Contrib0(u: int64, c: int64)
Contrib0(u, sum(t)) :- ContribTerm0(u, v, t).
.decl HasContrib0(v: int64)
HasContrib0(v) :- Contrib0(v, _).
.decl Dpart0(v: int64, dp: int64)
Dpart0(v, 85 * c / 100) :- Contrib0(v, c).
.decl PR1(v: int64, pr: int64)
PR1(v, b + dp) :- Base(b), Dpart0(v, dp).
PR1(v, b) :- Vertex(v), Base(b), !HasContrib0(v).
