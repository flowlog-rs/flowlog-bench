// DDlog translation of programs/oracle/souffle/galen.dl  (join order preserved; idioms per reference repo)
// inputs (csv -> relation): P.csv -> P, Q.csv -> Q, R.csv -> R, C.csv -> C, U.csv -> U, S.csv -> S
// sizes (printsize): OutP (P), OutQ (Q)

typedef node = signed<32>

input relation P(x: node, z: node)
input relation Q(x: node, y: node, z: node)
input relation R(r: node, p: node, e: node)
input relation C(y: node, z: node, w: node)
input relation U(r: node, z: node, w: node)
input relation S(r: node, p: node)

output relation OutP(x: node, z: node)
output relation OutQ(x: node, y: node, z: node)

// seeding rules: EDB -> IDB
OutP(x, z) :- P(x, z).
OutQ(x, r, z) :- Q(x, r, z).

// P(?x,?z) :- P(?x,?y), P(?y,?z).
OutP(x, z) :- OutP(x, y), OutP(y, z).
// Q(?x,?r,?z) :- P(?x,?y), Q(?y,?r,?z).
OutQ(x, r, z) :- OutP(x, y), OutQ(y, r, z).
// P(?x,?z) :- P(?y,?w), U(?w,?r,?z), Q(?x,?r,?y).
OutP(x, z) :- OutP(y, w), U(w, r, z), OutQ(x, r, y).
// P(?x,?z) :- C(?y,?w,?z),P(?x,?w), P(?x,?y).
OutP(x, z) :- C(y, w, z), OutP(x, w), OutP(x, y).
// Q(?x,?q,?z) :- Q(?x,?r,?z),S(?r,?q).
OutQ(x, q, z) :- OutQ(x, r, z), S(r, q).
// Q(?x,?e,?o) :- Q(?x,?y,?z),R(?y,?u,?e),Q(?z,?u,?o).
OutQ(x, e, o) :- OutQ(x, y, z), R(y, u, e), OutQ(z, u, o).

output relation RelationSizes(rel: string, size: bit<64>)
RelationSizes("OutP", size) :- OutP(x, z), var size = (x, z).group_by(()).count_distinct().
RelationSizes("OutQ", size) :- OutQ(x, y, z), var size = (x, y, z).group_by(()).count_distinct().
