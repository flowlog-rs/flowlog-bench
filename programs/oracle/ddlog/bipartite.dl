// DDlog translation of programs/oracle/souffle/bipartite.dl  (join order preserved; idioms per reference repo)
// inputs (csv -> relation): Arc.csv -> Arc, Source.csv -> Source
// sizes (printsize): BipartiteViolation, Zero, One

typedef node = signed<32>

input relation Arc(y: node, x: node)
input relation Source(x: node)

output relation BipartiteViolation(x: node)
output relation Zero(x: node)
output relation One(x: node)

Zero(x) :- Source(x).

One(y) :- Arc(x, y), Zero(x).
One(x) :- Arc(x, y), Zero(y).

Zero(y) :- Arc(x, y), One(x).
Zero(x) :- Arc(x, y), One(y).

BipartiteViolation(x) :- One(x), Zero(x).

output relation RelationSizes(rel: string, size: bit<64>)
RelationSizes("BipartiteViolation", size) :- BipartiteViolation(x), var size = (x).group_by(()).count_distinct().
RelationSizes("Zero", size) :- Zero(x), var size = (x).group_by(()).count_distinct().
RelationSizes("One", size) :- One(x), var size = (x).group_by(()).count_distinct().
