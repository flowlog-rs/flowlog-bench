// LDBC Graphalytics PageRank — UNROLLED K=30 (Souffle).
// Integer-scaled by 1e9, damping 0.85. Auto-generated; do not hand-edit.
.decl Arc(src: number, dst: number)
.input Arc(IO=file, filename="Arc.csv", delimiter=",")
.decl Vertex(v: number)
.input Vertex(IO=file, filename="Vertex.csv", delimiter=",")
.decl N(n: number)
N(n) :- n = count : { Vertex(_) }.
.decl Outdeg(v: number, d: number)
Outdeg(v, d) :- Arc(v, _), d = count : { Arc(v, _) }.
.decl Base(b: number)
Base(150000000 / n) :- N(n).
.decl PR0(v: number, pr: number)
PR0(v, 1000000000 / n) :- Vertex(v), N(n).
.decl ContribVal0(u: number, t: number)
ContribVal0(u, t) :- PR0(v, pr), Arc(v, u), Outdeg(v, d), t = pr / d.
.decl Contrib0(u: number, c: number)
Contrib0(u, c) :- ContribVal0(u, _), c = sum t : { ContribVal0(u, t) }.
.decl HasContrib0(v: number)
HasContrib0(v) :- Contrib0(v, _).
.decl Dpart0(v: number, dp: number)
Dpart0(v, 85 * c / 100) :- Contrib0(v, c).
.decl PR1(v: number, pr: number)
PR1(v, b + dp) :- Base(b), Dpart0(v, dp).
PR1(v, b) :- Vertex(v), Base(b), !HasContrib0(v).
.decl ContribVal1(u: number, t: number)
ContribVal1(u, t) :- PR1(v, pr), Arc(v, u), Outdeg(v, d), t = pr / d.
.decl Contrib1(u: number, c: number)
Contrib1(u, c) :- ContribVal1(u, _), c = sum t : { ContribVal1(u, t) }.
.decl HasContrib1(v: number)
HasContrib1(v) :- Contrib1(v, _).
.decl Dpart1(v: number, dp: number)
Dpart1(v, 85 * c / 100) :- Contrib1(v, c).
