// LDBC Graphalytics CDLP — UNROLLED K=10 (Souffle).
// Label propagation, mode label, smallest-id tie-break. Auto-generated.
.decl Arc(src: number, dst: number)
.input Arc(IO=file, filename="Arc.csv", delimiter=",")
.decl Vertex(v: number)
.input Vertex(IO=file, filename="Vertex.csv", delimiter=",")
.decl UndirEdge(u: number, v: number)
UndirEdge(u, v) :- Arc(u, v), u != v.
UndirEdge(v, u) :- Arc(u, v), u != v.
.decl Label0(v: number, l: number)
Label0(v, v) :- Vertex(v).
.decl NbrLabelCount0(v: number, l: number, c: number)
NbrLabelCount0(v, l, c) :- Label0(u, l), UndirEdge(v, u), c = count : { Label0(w, l), UndirEdge(v, w) }.
.decl ModeCount0(v: number, c: number)
ModeCount0(v, c) :- NbrLabelCount0(v, _, _), c = max cc : { NbrLabelCount0(v, _, cc) }.
.decl LabelNext0(v: number, l: number)
LabelNext0(v, l) :- ModeCount0(v, c), l = min ll : { NbrLabelCount0(v, ll, c) }.
.decl HasNbr0(v: number)
HasNbr0(v) :- NbrLabelCount0(v, _, _).
.decl Label1(v: number, l: number)
Label1(v, l) :- LabelNext0(v, l).
Label1(v, lprev) :- Label0(v, lprev), !HasNbr0(v).
.decl NbrLabelCount1(v: number, l: number, c: number)
